# HTTP port of the API
PORT=4000

# SQLite for local development (path is relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Frontend origin(s) allowed by CORS, comma-separated
CORS_ORIGIN=http://localhost:3000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# POST requests allowed per minute per IP (login/register have their own stricter limit)
RATE_LIMIT_PER_MIN=20
AUTH_RATE_LIMIT_PER_MIN=10

# How long a login stays valid
SESSION_TTL_DAYS=30

# Superadmin password used by `npm run db:seed` (username: admin).
# Empty in development = the frontend's demo password. Required in production.
SUPERADMIN_PASSWORD=

# POST /api/v1/admin/reset-demo. Default: on outside production, off in production.
DEMO_RESET_ENABLED=

# Reverse proxies in front of the API (0 locally, 1 on Render)
TRUST_PROXY=0

# Where uploaded images are stored (relative to backend/ or absolute)
UPLOAD_DIR=public/uploads
